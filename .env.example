# ── Local Development ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is listed in .gitignore and is NEVER committed to the repository.

# Flask secret key — change to any long random string in production.
SECRET_KEY=change-this-to-a-random-string

# Database URL.
# Leave blank (or remove) to use the local SQLite fallback automatically.
# For local PostgreSQL testing:
#   DATABASE_URL=postgresql://user:password@localhost:5432/daily_tracker
# On Render this is set automatically when you link a PostgreSQL database.
DATABASE_URL=

# Flask debug mode (set to 0 in production).
FLASK_DEBUG=1

# ── Web Push / VAPID keys ─────────────────────────────────────────────────────
# Generate once with:
#   pip install py-vapid
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); \
#              print('PRIVATE:', v.private_pem().decode()); \
#              print('PUBLIC:', v.public_key.public_bytes_raw().hex())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
